-- ----------------------------------------------------------------------
-- 1. BACKEND: ระบบปั๊มยาอัตโนมัติ
-- ----------------------------------------------------------------------
local remoteCache = nil
local function GetUseItemRemote()
    if remoteCache and remoteCache.Parent then return remoteCache end
    remoteCache = nil
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local r = remotes and remotes:FindFirstChild("UseItem")
    if not r then
        for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
            if d.Name == "UseItem" and (d:IsA("RemoteEvent") or d:IsA("RemoteFunction")) then
                r = d
                break
            end
        end
    end
    remoteCache = r
    return r
end

local function UseItem(itemName)
    local remote = GetUseItemRemote()
    if not remote then return end
    pcall(function()
        if remote:IsA("RemoteFunction") then
            remote:InvokeServer(3, itemName, nil, nil, true)
        else
            remote:FireServer(3, itemName, nil, nil, true)
        end
    end)
end

local lastHealTime = 0
local isProcessing = false

local function TryHeal()
    if not AutoHealConfig.Enabled or isProcessing then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if not hum or hum.Health <= 0 then return end
    if (hum.Health / hum.MaxHealth) > AutoHealConfig.Threshold then return end
    if (os.clock() - lastHealTime) < AutoHealConfig.Cooldown then return end

    isProcessing = true
    lastHealTime = os.clock()
    
    task.spawn(function()
        UseItem(AutoHealConfig.Item)
        task.wait(0.1)
        isProcessing = false
    end)
end

-- ลูปเช็คเลือด
task.spawn(function()
    while true do
        if AutoHealConfig.Enabled then
            TryHeal()
        end
        task.wait(0.25)
    end
end)

