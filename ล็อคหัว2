-- ฟังก์ชันสร้างปุ่ม Toggle
local function createToggle(parent, name, defaultState, callback)
    local btn = Instance.new("TextButton", parent)
    local state = defaultState
    btn.BackgroundColor3 = state and Color3.fromRGB(160, 50, 110) or Color3.fromRGB(25, 20, 32)
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = name
    btn.TextColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 170, 190)
    btn.TextSize = 11
    
    local btnCorner = Instance.new("UICorner", btn)
    btnCorner.CornerRadius = UDim.new(0, 8)
    
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(160, 50, 110) or Color3.fromRGB(25, 20, 32)
        btn.TextColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 170, 190)
        callback(state)
    end)
end

