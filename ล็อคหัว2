-- 2. ENEMY HEALTH BAR & DISTANCE ESP (หลอดเลือด + % + ระยะห่าง)
-- ----------------------------------------------------------------------
local healthBars = {}

local function removeHealthBar(player)
    if healthBars[player] then
        for _, drawing in pairs(healthBars[player]) do
            drawing:Remove()
        end
        healthBars[player] = nil
    end
end

RunService.RenderStepped:Connect(function()
    if not _G.EnemyHealthBarEnabled then
        for player, _ in pairs(healthBars) do
            removeHealthBar(player)
        end
        return
    end

    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid") then
            local char = player.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            local rootPart = char.FindFirstChild(char, "HumanoidRootPart")

            if hum.Health > 0 and localRoot then
                local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position + Vector3.new(0, 2.5, 0))
                
                if onScreen then
                    if not healthBars[player] then
                        local bgBar = Drawing.new("Square")
                        bgBar.Size = Vector2.new(46, 6)
                        bgBar.Color = Color3.fromRGB(20, 15, 25)
                        bgBar.Filled = true
                        bgBar.Visible = false

                        local innerBar = Drawing.new("Square")
                        innerBar.Size = Vector2.new(42, 2)
                        innerBar.Color = Color3.fromRGB(255, 105, 180) -- สีชมพูนีออนซากุระ
                        innerBar.Filled = true
                        innerBar.Visible = false

                        local text = Drawing.new("Text")
                        text.Size = 11
                        text.Center = true
                        text.Outline = true
                        text.Color = Color3.fromRGB(255, 255, 255)
                        text.Font = Drawing.Fonts.UI
                        text.Visible = false

                        local distText = Drawing.new("Text")
                        distText.Size = 10
                        distText.Center = true
                        distText.Outline = true
                        distText.Color = Color3.fromRGB(220, 180, 240) -- สีม่วงอ่อนสบายตา
                        distText.Font = Drawing.Fonts.UI
                        distText.Visible = false

                        healthBars[player] = {bg = bgBar, inner = innerBar, txt = text, dist = distText}
                    end

                    local bars = healthBars[player]
                    local healthPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    local distance = math.floor((rootPart.Position - localRoot.Position).Magnitude)

                    bars.bg.Position = Vector2.new(vector.X - 23, vector.Y - 10)
                    bars.bg.Visible = true

                    bars.inner.Position = Vector2.new(vector.X - 21, vector.Y - 8)
                    bars.inner.Size = Vector2.new(42 * healthPercent, 2)
                    bars.inner.Visible = true

                    bars.txt.Text = math.floor(healthPercent * 100) .. "%"
                    bars.txt.Position = Vector2.new(vector.X, vector.Y - 26)
                    bars.txt.Visible = true

                    bars.dist.Text = "[" .. distance .. "m]"
                    bars.dist.Position = Vector2.new(vector.X, vector.Y + 4)
                    bars.dist.Visible = true
                else
                    if healthBars[player] then
                        healthBars[player].bg.Visible = false
                        healthBars[player].inner.Visible = false
                        healthBars[player].txt.Visible = false
                        healthBars[player].dist.Visible = false
                    end
                end
            else
                removeHealthBar(player)
            end
        else
            removeHealthBar(player)
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
